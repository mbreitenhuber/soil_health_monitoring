# ============================================
# SATELLITE DATA APIs
# ============================================

# Copernicus Dataspace (Sentinel-2)
COPERNICUS_USER=your_copernicus_username
COPERNICUS_PASSWORD=your_copernicus_password

SENTINEL_DIR= Target directory for the cropped Sentinel-2 files
TMP_DIR= Temporary working directory (ramdisk recommended)

# AWS S3 (Copernicus EOData)
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key

# ============================================
# DATA PATHS
# ============================================

# SQLite database used by the personal dashboard
AGROSCAN_DB_PATH=/persistent-data/agroscan.db

# Root directory for trained models (used by the backend and prediction pipeline)
AGROSCAN_MODEL_PATH=./data

# Distance in meters used to match grid centers to cached Sentinel crops
AGROSCAN_GRID_MATCH_RADIUS_M=10

# Root directory for datasets (CSV files, raw data)
DATASET_PATH=./data/datasets

# Root directory for trained models
MODEL_PATH=./data/models


