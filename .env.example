# ============================================
# SATELLITE DATA APIs
# ============================================

# Copernicus Dataspace (Sentinel-2)
COPERNICUS_USER=your_copernicus_username
COPERNICUS_PASSWORD=your_copernicus_password
SENTINEL_DIR= Target directory for the cropped Sentinel-2 files
TMP_DIR= Temporary working directory (ramdisk recommended)
COPERNICUS_TOKEN=your_generated_token
COPERNICUS_TOKEN_EXPIRES=your_token_expiry_timestamp

# AWS S3 (Copernicus EOData)
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key

# USGS Landsat (M2M API)
M2M_USER=your_usgs_username
M2M_SECRET=your_usgs_api_secret
M2M_TOKEN=your_generated_m2m_token
M2M_TOKEN_EXPIRES=your_m2m_token_expiry

# ============================================
# WEATHER DATA APIs
# ============================================

# OpenWeatherMap
OPENWEATHERMAP_KEY=your_openweathermap_api_key

# ============================================
# DATA PATHS
# ============================================

# Root directory for datasets (CSV files, raw data)
DATASET_PATH=./data/datasets

# Root directory for trained models
MODEL_PATH=./data/models


